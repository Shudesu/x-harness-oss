{
  "name": "x-harness-oss",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source X (Twitter) CRM/marketing automation — Xステップ代替",
  "homepage": "https://the-harness.com/x-harness/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shudesu/x-harness-oss.git"
  },
  "bugs": {
    "url": "https://github.com/Shudesu/x-harness-oss/issues"
  },
  "author": {
    "name": "野田修一 (Shudesu)",
    "url": "https://the-harness.com/noda-shuichi/"
  },
  "scripts": {
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker deploy",
    "db:migrate": "wrangler d1 execute x-harness --file=packages/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute x-harness --file=packages/db/schema.sql --local",
    "db:migrate:004": "wrangler d1 execute x-harness --file=packages/db/migrations/004-polling-columns.sql",
    "db:migrate:004:local": "wrangler d1 execute x-harness --file=packages/db/migrations/004-polling-columns.sql --local",
    "db:migrate:005": "wrangler d1 execute x-harness --file=packages/db/migrations/005-reply-trigger.sql",
    "db:migrate:005:local": "wrangler d1 execute x-harness --file=packages/db/migrations/005-reply-trigger.sql --local",
    "db:migrate:018": "wrangler d1 execute x-harness --file=packages/db/migrations/018-growth-article-x-draft.sql",
    "db:migrate:018:local": "wrangler d1 execute x-harness --file=packages/db/migrations/018-growth-article-x-draft.sql --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
